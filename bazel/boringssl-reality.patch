+// REALITY: replace the key_share extension's ciphertext in a ServerHello in
+// place. Assumes the same group (and thus same ciphertext length), which holds
+// when both sides use X25519. Returns false on any parse/length mismatch.
+static bool reality_replace_key_share(Array<uint8_t> *sh,
+                                      Span<const uint8_t> new_ks) {
+  uint8_t *p = sh->data();
+  size_t len = sh->size();
+  // handshake header(4) + legacy_version(2) + random(32) + session_id_len(1)
+  if (len < 4 + 2 + 32 + 1) {
+    return false;
+  }
+  size_t off = 4 + 2 + 32;
+  off += 1 + p[off];             // session_id
+  off += 2 + 1;                  // cipher_suite + compression
+  if (off + 2 > len) {
+    return false;
+  }
+  size_t ext_total = (size_t(p[off]) << 8) | p[off + 1];
+  off += 2;
+  size_t ext_end = off + ext_total;
+  if (ext_end > len) {
+    return false;
+  }
+  while (off + 4 <= ext_end) {
+    uint16_t etype = (uint16_t(p[off]) << 8) | p[off + 1];
+    uint16_t elen = (uint16_t(p[off + 2]) << 8) | p[off + 3];
+    off += 4;
+    if (off + elen > ext_end) {
+      return false;
+    }
+    if (etype == TLSEXT_TYPE_key_share) {
+      // server_share = group(2) + key_len(2) + key_data(key_len)
+      if (elen < 4) {
+        return false;
+      }
+      uint16_t key_len = (uint16_t(p[off + 2]) << 8) | p[off + 3];
+      if (4 + key_len != elen || key_len != new_ks.size()) {
+        return false;
+      }
+      fprintf(stderr, "REALITY_SRV_DBG inject_ks[0..8]=");
+      for (size_t i = 0; i < 8 && i < new_ks.size(); i++)
+        fprintf(stderr, "%02x", new_ks.data()[i]);
+      fprintf(stderr, " ks_len=%zu\n", new_ks.size());
+      OPENSSL_memcpy(p + off + 4, new_ks.data(), new_ks.size());
+      return true;
+    }
+    off += elen;
+  }
+  return false;
+}

+// === REALITY byte-level ServerHello mirror hook ===
+// When set via SSL_set_reality_serverhello_cb, do_send_server_hello consults
+// this callback. If it returns a non-null buffer, that real-target ServerHello
+// is emitted byte-for-byte (only key_share is replaced with our own), so the
+// ServerHello's extension order/set matches the mirror target exactly.
+bool (*reality_serverhello_cb)(SSL *ssl, const uint8_t **out, size_t *out_len) =
+    nullptr;
+
+extern "C" void SSL_set_reality_serverhello_cb(
+    bool (*cb)(SSL *ssl, const uint8_t **out, size_t *out_len)) {
+  reality_serverhello_cb = cb;
+}
